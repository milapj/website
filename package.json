{
  "name": "milapj-website",
  "version": "2.0.0",
  "description": "Dr. Milap Jhumkhawala's personal website: a retro top-down game you walk through",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.ts --outfile=main.js --bundle --target=es2016 --minify",
    "build:dev": "esbuild src/main.ts --outfile=main.js --bundle --target=es2016",
    "serve": "esbuild src/main.ts --servedir=. --outfile=main.js --bundle --target=es2016",
    "map": "python3 tools/build_map.py",
    "typecheck": "tsc --noEmit"
  },
  "author": "Milap Jhumkhawala",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.1.6"
  },
  "dependencies": {
    "grid-engine": "^2.32.3",
    "phaser": "^3.60.0"
  }
}
